generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tournament {
  id        Int      @id
  name      String
  week      String
  date      String
  season    Int      @default(1)
  isMajor   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results            Result[]
  launchMonitorShots LaunchMonitorShot[]
  weeklyPrize        WeeklyPrize?
  playerRoundStats   PlayerRoundStats[]
  longDrives         LongDrive[]
  courseSetup        CourseSetup?
}

// Course + round settings for an event, from the SGT tournament page (npm run scrape-course)
model CourseSetup {
  id           Int     @id @default(autoincrement())
  tournamentId Int     @unique
  courseName   String  // SGT course name — groups events in the Course Journal
  sgtCourseId  Int?
  coursePar    Int?    // full 18-hole par; slope/rating are 18-hole values too
  tees         String?
  slope        Int?
  rating       Float?
  stimp        Int?
  fairways     String?
  greens       String?
  pins         String?
  weather      String?
  wind         String?
  gimmies      String?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}

// Free-form league notes per course, keyed by CourseSetup.courseName
model CourseJournal {
  courseName String   @id
  notes      String
  updatedAt  DateTime @updatedAt
}

model WeeklyPrize {
  id           Int     @id @default(autoincrement())
  tournamentId Int     @unique
  skinsWinner  String? // player ID or null if NA
  ctpWinner    String? // player ID or null if NA
  netWinner    String? // player ID or null if NA

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}

model Player {
  id       String @id
  handicap Int

  results            Result[]
  coachingReports    CoachingReport[]
  shotData           ShotData[]
  launchMonitorShots LaunchMonitorShot[]
  playerRoundStats   PlayerRoundStats[]
  longDrives         LongDrive[]
}

model Result {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  playerId     String
  type         String // "gross" or "net"
  position     Int
  score        String
  points       Float
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId, type])
}

model ShotData {
  id           Int      @id @default(autoincrement())
  playerId     String
  tournamentId Int
  holeNumber   Int
  par          Int
  shots        String   // JSON array of shot strings, e.g. ["201 yds to fairway, 183 yds to hole", ...]
  shotsCount   Int
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId, holeNumber])
}

model LaunchMonitorShot {
  id            Int     @id @default(autoincrement())
  tournamentId  Int
  playerId      String
  roundKey      String
  shotKey       String  @unique
  hole          Int
  holeShot      Int
  globalShotNum Int
  clubName      String
  shotResult    String?
  // PlayerShots fields
  ballSpeed     Float?
  carryDist     Float?
  totalDist     Float?
  distToPin     Float?
  peakHeight    Float?
  offline       Float?
  // PlayerShotMeasures fields (launch monitor)
  clubSpeed     Float?
  backSpin      Float?
  spinAxis      Float?
  clubAoA       Float?
  clubPath      Float?
  faceToPath    Float?
  faceToTarget  Float?
  descAngle     Float?
  hla           Float?
  vla           Float?

  createdAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@index([tournamentId, playerId])
}

model PlayerRoundStats {
  id            Int    @id @default(autoincrement())
  tournamentId  Int
  playerId      String

  scoringAvg    Float?
  drivingDist   Float?
  fir           Float?
  gir           Float?
  sandSave      Float?
  scrambling    Float?
  puttsPerRound Float?
  puttsPerGir   Float?
  girProximity  Float?

  createdAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
}

model LongDrive {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  holeNumber   Int
  playerId     String
  distanceYds  Float

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, holeNumber, playerId])
}

model CoachingReport {
  id           Int      @id @default(autoincrement())
  playerId     String
  tournamentId Int
  report       String
  shotDataJson String?
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, tournamentId])
}
